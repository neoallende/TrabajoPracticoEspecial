package views

templ Layout(titulo string, contenido templ.Component) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ titulo }</title>
			<link rel="stylesheet" href="/styles.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.8" defer></script>
		</head>
		<body>
			<div id="indicador-carga" class="indicador-carga htmx-indicator" role="status" aria-live="polite">
				Cargando…
			</div>
			@contenido
		</body>
	</html>
}